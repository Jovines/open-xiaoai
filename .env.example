# Copy to ~/.config/open-xiaoai-recorder/env and chmod 600.
RECORDER_HOST=192.168.8.242
RECORDER_USER=root
RECORDER_OUTPUT_DIR=/mnt/dx4600/家庭管家/录音/inbox
RECORDER_REQUIRED_MOUNT=/mnt/dx4600
RECORDER_SEGMENT_SECONDS=60
RECORDER_SAMPLE_RATE=48000
RECORDER_ARCHIVE_CHANNELS=3
# 16 TB NAS 场景优先保留三麦阵列的 24-bit 无损数据。
RECORDER_CODEC=flac
RECORDER_BITRATE=96k
RECORDER_RETRY_SECONDS=5
RECORDER_RETENTION_DAYS=0
RECORDER_MIN_FREE_GB=5
RECORDER_LOG_LEVEL=INFO

# CPU 转写与证据处理（此服务会显式禁用 CUDA）
PROCESSOR_INPUT_DIR=/mnt/dx4600/家庭管家/录音/inbox
PROCESSOR_EVIDENCE_DIR=/mnt/dx4600/家庭管家/录音/evidence
PROCESSOR_DISCARD_DIR=/mnt/dx4600/家庭管家/录音/discarded
PROCESSOR_REQUIRED_MOUNT=/mnt/dx4600
PROCESSOR_NAS_URI_ROOT=nas://dx4600/家庭管家/录音/evidence
SENSEVOICE_BINARY=/home/qiao/.local/opt/sensevoice/llama-funasr-sensevoice
SENSEVOICE_MODEL=/home/qiao/models/sensevoice-small/sensevoice-small-q8.gguf
SENSEVOICE_VAD_MODEL=/home/qiao/models/sensevoice-small/fsmn-vad.gguf
QWEN_ASR_MODEL=Qwen/Qwen3-ASR-1.7B
HF_HOME=/home/qiao/models/huggingface
HF_HUB_OFFLINE=1
PROCESSOR_SETTLE_SECONDS=5
PROCESSOR_POLL_SECONDS=3
PROCESSOR_DISCARD_GRACE_HOURS=72

# 与 Zeris 使用同一份随机密钥；不要提交真实值
ZERIS_AUDIO_INGEST_URL=http://192.168.8.137:3000/api/agent/audio/events
ZERIS_AUDIO_INGEST_TOKEN=change-me

# Used by sshpass. Prefer an SSH key when convenient.
SSHPASS=open-xiaoai
