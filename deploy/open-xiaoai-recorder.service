[Unit]
Description=Open-XiaoAI continuous room recorder
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/mnt/dx4600

[Service]
Type=simple
WorkingDirectory=%h/vscode/open-xiaoai
EnvironmentFile=%h/.config/open-xiaoai-recorder/env
ExecStart=/usr/bin/python3 %h/vscode/open-xiaoai/recorder.py
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
